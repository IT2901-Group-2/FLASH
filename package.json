{
  "name": "@flash/root",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter website dev",
    "start": "pnpm --filter website start",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "storybook": "pnpm --filter ui storybook",
    "storybook:build": "pnpm --filter ui build-storybook",
    "docker": "docker build . -t flash"
  },
  "packageManager": "pnpm@10.33.2"
}
