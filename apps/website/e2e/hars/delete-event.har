            "text": "/* [project]/apps/website/src/app/[locale]/(sidebar)/admin/dashboard/page.module.css [app-client] (css) */\n.page-module__ujqwuW__header {\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  display: flex;\n  position: relative;\n}\n\n.page-module__ujqwuW__filterContainer {\n  flex-wrap: wrap;\n  gap: 0 1rem;\n  min-width: min-content;\n  display: flex;\n}\n\n.page-module__ujqwuW__filterContainer > :first-child {\n  min-width: 15rem;\n  max-width: 25rem;\n}\n\n.page-module__ujqwuW__filterContainer .page-module__ujqwuW__filterSection {\n  flex-flow: wrap;\n  align-items: end;\n  gap: 1rem;\n  display: flex;\n}\n\n.page-module__ujqwuW__filterContainer .page-module__ujqwuW__filterSection > button {\n  margin-bottom: .575rem;\n}\n\n@media screen and (max-width: 768px) {\n  .page-module__ujqwuW__createButton {\n    position: fixed;\n    bottom: 1rem;\n    width: clamp(19rem, 100% - 4rem, 100%) !important;\n  }\n}\n\n.page-module__ujqwuW__eventsContainer {\n  grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));\n  gap: 1rem;\n  margin-top: 1rem;\n  display: grid;\n}\n\n.page-module__ujqwuW__loadingContainer {\n  grid-column: 1 / -1;\n  justify-content: center;\n  align-items: center;\n  display: flex;\n}\n\n.page-module__ujqwuW__loadMoreSentinel {\n  grid-column: 1 / -1;\n  width: 100%;\n  height: 1px;\n}\n\n/* [project]/apps/website/src/components/EventDialogs/CreateEventDialog.module.css [app-client] (css) */\n.CreateEventDialog-module__-vafKq__container {\n  background-color: #0000;\n  border: none;\n  width: clamp(28rem, 50%, 48rem);\n  margin-top: 2.5vh;\n  padding: 0;\n}\n\n.CreateEventDialog-module__-vafKq__container::backdrop {\n  background-color: var(--color-backdrop);\n}\n\n@media screen and (max-width: 768px) {\n  .CreateEventDialog-module__-vafKq__container {\n    width: 100vw;\n    max-width: 100vw;\n    height: 100vh;\n    min-height: 100vh;\n    margin: 0;\n    padding: 0;\n  }\n}\n\n.CreateEventDialog-module__-vafKq__form {\n  flex-direction: column;\n  gap: 1rem;\n  display: flex;\n  overflow-y: auto;\n}\n\n.CreateEventDialog-module__-vafKq__buttonGroup {\n  border-top: 1px solid var(--color-border-base);\n  flex-flow: wrap;\n  justify-content: end;\n  gap: 1rem;\n  margin-top: .5rem;\n  padding-top: .5rem;\n  display: flex;\n}\n\n.CreateEventDialog-module__-vafKq__buttonGroup > :first-child:not(:only-child) {\n  margin-right: auto;\n}\n\n/* [project]/apps/website/src/components/EventDialogs/Steps/Steps.module.css [app-client] (css) */\n.Steps-module__0HZ3va__maxImageContainer {\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  gap: 1rem;\n  display: flex;\n}\n\n.Steps-module__0HZ3va__maxImageContainer > span {\n  width: max-content;\n}\n\n.Steps-module__0HZ3va__infoContainer {\n  flex-direction: row;\n  gap: 2rem;\n  display: flex;\n}\n\n.Steps-module__0HZ3va__scroll {\n  overflow-y: auto;\n}\n\n@media screen and (max-width: 1024px) {\n  .Steps-module__0HZ3va__infoContainer {\n    flex-direction: column-reverse;\n  }\n}\n\n.Steps-module__0HZ3va__QRCodeContainer {\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n  display: flex;\n}\n\n.Steps-module__0HZ3va__QRCodeContainer > button {\n  width: 100%;\n}\n\n.Steps-module__0HZ3va__linkContainer {\n  flex-direction: column;\n  flex: 1;\n  justify-content: center;\n  display: flex;\n}\n\n.Steps-module__0HZ3va__timeContainer {\n  white-space: nowrap;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 1rem;\n  width: 100%;\n  display: grid;\n}\n\n.Steps-module__0HZ3va__timeContainer > * {\n  margin-right: auto;\n}\n\n.Steps-module__0HZ3va__copyContainer {\n  justify-content: flex-start;\n  align-items: start;\n  gap: .5rem;\n  width: 100%;\n  display: flex;\n}\n\n.Steps-module__0HZ3va__copyContainer > div {\n  width: 100%;\n}\n\n@media screen and (max-width: 480px) {\n  .Steps-module__0HZ3va__timeContainer {\n    grid-template-columns: repeat(1, 1fr);\n  }\n\n  .Steps-module__0HZ3va__timeContainer > * {\n    margin-right: none;\n    width: 100%;\n  }\n}\n\n/* [project]/apps/website/src/components/EventCard/EventCard.module.css [app-client] (css) */\n.EventCard-module__LI_DvW__card {\n  cursor: pointer;\n}\n\n.EventCard-module__LI_DvW__card:hover {\n  background-color: var(--color-primary-light);\n}\n\n.EventCard-module__LI_DvW__card:active {\n  background-color: var(--color-primary-dark);\n}\n\n.EventCard-module__LI_DvW__title {\n  margin: 0;\n}\n\n.EventCard-module__LI_DvW__footer {\n  border-top: 1px solid var(--color-border-base);\n  justify-content: space-between;\n  padding-top: 1rem;\n}\n\n.EventCard-module__LI_DvW__actionButton {\n  border-radius: var(--radius-8);\n  border: .1rem solid var(--color-border-base);\n  cursor: pointer;\n  color: var(--color-text-secondary);\n  background-color: #0000;\n  justify-content: center;\n  align-items: center;\n  padding: .25rem;\n  display: flex;\n}\n\n.EventCard-module__LI_DvW__actionButton[data-color] {\n  border: .1rem solid var(--color-base);\n  color: var(--color-base);\n}\n\n.EventCard-module__LI_DvW__actionButton[data-color]:hover {\n  color: var(--color-primary-base);\n  background-color: var(--color-light);\n}\n\n.EventCard-module__LI_DvW__actionButton[data-color]:active {\n  background-color: var(--color-dark);\n}\n\n.EventCard-module__LI_DvW__info {\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  display: flex;\n}\n\n.EventCard-module__LI_DvW__soft {\n  color: var(--color-text-base);\n}\n\n.EventCard-module__LI_DvW__soft > span {\n  color: var(--color-text-secondary);\n}\n\n.EventCard-module__LI_DvW__row {\n  align-items: center;\n  gap: .5rem;\n  display: flex;\n}\n\n.EventCard-module__LI_DvW__column {\n  flex-direction: column;\n  gap: .5rem;\n  display: flex;\n}\n\n/*# sourceMappingURL=apps_website_src_0y27on5._.css.map*/"
