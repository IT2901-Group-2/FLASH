            "text": "/* [project]/apps/website/src/components/Logo/Logo.module.css [app-client] (css) */\n.Logo-module__kxB0qq__logoWrapper {\n  aspect-ratio: 1;\n  border-radius: var(--radius-8);\n  justify-content: center;\n  align-items: center;\n  width: 3.5rem;\n  height: 3.5rem;\n  padding: .25rem;\n  display: flex;\n}\n\n.Logo-module__kxB0qq__logoWrapper[data-redirect=\"true\"] {\n  cursor: pointer;\n}\n\n/* [project]/apps/website/src/components/Sidebar/LanguageSwitch.module.css [app-client] (css) */\n.LanguageSwitch-module__mLmTSa__switch {\n  border-radius: var(--radius-full);\n  border: .1rem solid var(--color-border-base);\n  cursor: pointer;\n  background: none;\n  width: 4rem;\n  height: 1.5rem;\n  padding: 0;\n  position: relative;\n  overflow: hidden;\n}\n\n.LanguageSwitch-module__mLmTSa__backdrop {\n  border-radius: var(--radius-full);\n  background-color: var(--color-accent-base);\n  position: absolute;\n  inset: 0;\n}\n\n[lang-index=\"0\"] .LanguageSwitch-module__mLmTSa__backdrop {\n  clip-path: polygon(0 0, 58% 0, 42% 100%, 0 100%);\n}\n\n[lang-index=\"1\"] .LanguageSwitch-module__mLmTSa__backdrop {\n  clip-path: polygon(58% 0, 100% 0, 100% 100%, 42% 100%);\n}\n\n.LanguageSwitch-module__mLmTSa__label {\n  z-index: 1;\n  align-items: center;\n  display: flex;\n  position: absolute;\n  inset: 0;\n}\n\n.LanguageSwitch-module__mLmTSa__label > span {\n  text-align: center;\n  font-size: var(--font-size-xsmall);\n  font-weight: var(--font-weight-bold);\n  flex: 1;\n}\n\n/* [project]/apps/website/src/components/Sidebar/ModTag.module.css [app-client] (css) */\n.ModTag-module__NSQxAq__container {\n  justify-content: space-between;\n  align-items: center;\n  gap: .5rem;\n  display: flex;\n}\n\n.ModTag-module__NSQxAq__tag {\n  border-radius: var(--radius-full);\n  background-color: var(--color-accent-base);\n  font-size: var(--font-size-small);\n  justify-content: center;\n  align-items: center;\n  gap: .25rem;\n  padding: .25rem .5rem;\n  display: flex;\n}\