            "size": -1,
            "mimeType": "text/css; charset=UTF-8",
            "text": "/* [project]/apps/website/src/components/SignInCard/SignInCard.module.css [app-client] (css) */\n.SignInCard-module__k1l5Ha__card {\n  box-shadow: var(--shadow-dialog);\n  --input-bg: var(--color-background-base);\n  flex-direction: column;\n  gap: 1rem;\n  display: flex;\n}\n\n.SignInCard-module__k1l5Ha__content {\n  flex-direction: column;\n  gap: 1rem;\n  display: flex;\n}\n\n/* [project]/apps/website/src/app/[locale]/admin/AdminLogin.module.css [app-client] (css) */\n.AdminLogin-module__xswnnG__pageWrapper {\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  gap: 2rem;\n  width: clamp(20rem, 100%, 100vw);\n  margin: auto;\n  padding: 1rem;\n  display: flex;\n}\n\n/* [project]/apps/website/src/components/Logo/Logo.module.css [app-client] (css) */\n.Logo-module__kxB0qq__logoWrapper {\n  aspect-ratio: 1;\n  border-radius: var(--radius-8);\n  justify-content: center;\n  align-items: center;\n  width: 3.5rem;\n  height: 3.5rem;\n  padding: .25rem;\n  display: flex;\n}\n\n.Logo-module__kxB0qq__logoWrapper[data-redirect=\"true\"] {\n  cursor: pointer;\n}\n\n/* [project]/apps/website/src/components/ConfigButtons/ConfigButtons.module.css [app-client] (css) */\n.ConfigButtons-module__QD10la__button {\n  border: .125rem solid var(--color-border-light);\n  border-radius: var(--radius-full);\n  background-color: var(--color-primary-base);\n  min-height: 2.5rem;\n  color: var(--color-text-base);\n  font-family: var(--font-family);\n  font-size: var(--font-size-small);\n  cursor: pointer;\n  justify-content: center;\n  align-items: center;\n  gap: .5rem;\n  padding: .5rem .85rem;\n  transition: background-color .1s, border-color .1s, transform .1s;\n  display: inline-flex;\n  position: absolute;\n  top: 2rem;\n}\n\n.ConfigButtons-module__QD10la__button:hover {\n  background-color: var(--color-primary-light);\n}\n\n.ConfigButtons-module__QD10la__button:active {\n  background-color: var(--color-primary-dark);\n  transform: translateY(1px);\n}\n\n.ConfigButtons-module__QD10la__button:focus-visible {\n  outline: 2px solid var(--color-border-light);\n  outline-offset: 2px;\n}\n\n.ConfigButtons-module__QD10la__left {\n  left: 2rem;\n}\n\n.ConfigButtons-module__QD10la__right {\n  right: 2rem;\n}\n\n@media (max-width: 768px) {\n  .ConfigButtons-module__QD10la__button {\n    min-height: 2.75rem;\n    font-size: var(--font-size-medium);\n    padding: .65rem .95rem;\n  }\n}\n\n/*# sourceMappingURL=apps_website_src_0pa88xx._.css.map*/"
