{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@utils": ["./src/utils"]
    }
  },
  "include": [
    "src/**/*.ts",
    "types.ts",
    "__test__/kebabCase.test.ts",
    "__test__/merge.test.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-esm"]
}
