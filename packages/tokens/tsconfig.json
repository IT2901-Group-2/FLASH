{
  "compilerOptions": {
    "target": "es2021",
    "module": "preserve",
    "lib": ["es2021", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@types": ["./types"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
