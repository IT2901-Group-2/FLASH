{
  "compilerOptions": {
    "target": "es2021",
    "module": "ESNext",
    "lib": ["es2021", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@styles/*": ["src/styles/*"],
      "@docs/*": ["src/docs/*"],
      "@docs-components/*": [".storybook/components/*"]
    }
  },
  "include": [
    "src",
    "temp.ts",
    "src/types/global.d.ts",
    ".storybook/DocsTemplate.tsx",
    ".storybook/components"
  ],
  "exclude": ["node_modules", "dist"]
}
